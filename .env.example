# SOLARIS - Personal AI Assistant Configuration
# Copy this file to .env and fill in your values

# === AI Provider ===
# Primary AI provider: gemini or ollama
AI_PROVIDER=gemini

# Google Gemini API key (get from makersuite.google.com)
# Get your free key here: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model name
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama settings (optional - only needed if using local AI)
# Install Ollama from: https://ollama.ai
# OLLAMA_MODEL=llama3.2-vision

# === Assistant Branding ===
ASSISTANT_NAME=SOLARIS
VERSION=1.0.0
WAKE_PHRASE=Hey Solaris

# === Voice Settings ===
# Voice style: A = Natural conversational, B = Deep cinematic
VOICE_STYLE=A

# Text-to-speech voice ID (edge-tts voice name)
# Voice A: en-US-JennyNeural (natural, human-like)
# Voice B: en-US-Sara-Natural (deep, cinematic)
VOICE=en-US-JennyNeural

# Speech speed multiplier (0.5 to 2.0)
SPEED=1.0

# Microphone device name (optional - leave empty to use default)
MICROPHONE=

# === Wake Word ===
# Enable 'Hey Solaris' wake word detection
ENABLE_WAKE_WORD=true

# === Interface Settings ===
# Orb radius in pixels
ORB_RADIUS=60

# Orb opacity (0.0 to 1.0)
ORB_OPACITY=1.0

# Show tooltips and hints
SHOW_TOOLTIPS=true

# === Windows Integration ===
# Launch SOLARIS automatically at Windows startup
ENABLE_WINDOWS_STARTUP=false

# Show SOLARIS in system tray
SYSTEM_TRAY=true

# === Serious Mode ===
# Enable deep research mode
ENABLE_SERIOUS_MODE=true

# === Reminders ===
# Enable reminder system
ENABLE_REMINDERS=true

# === Focus Mode ===
# Enable Focus Mode
ENABLE_FOCUS_MODE=true

# === Health / Telemetry ===
# LibreHardwareMonitor API URL (for CPU/GPU monitoring)
LIBRE_HARDWARE_MONITOR_URL=http://localhost:8085/data.json

# Hide main window when capturing screen
HIDE_ON_CAPTURE=true

# === Port ===
# Port for the local SOLARIS server
PORT=5005